# Python FastAPI Server Configuration
MODEL_DIR=models
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_REQUEST_SIZE=1048576

# Coinbase API Configuration (Node Backend)
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here
COINBASE_PASSPHRASE=your_passphrase_here

# Node Backend Configuration
NODE_BACKEND_PORT=3001
PYTHON_SERVER_URL=http://localhost:8000

# Security Notes:
# - Never commit the actual .env file with real credentials
# - Keep API keys and secrets secure
# - Use environment-specific configurations for different deployments
# - Enable TLS/SSL in production environments
