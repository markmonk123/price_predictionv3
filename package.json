{
  "name": "bitcoin-fix-trading-platform",
  "version": "2.0.0",
  "description": "Bitcoin prediction platform with paper and Coinbase Advanced Trade brokers",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm --prefix client run dev",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "mcp": "node mcp/server.js",
    "test": "node --test --test-concurrency=1 \"server/__tests__/*.test.js\" \"mcp/__tests__/*.test.js\""
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.31.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cache": "^5.1.2",
    "python-shell": "^5.0.0",
    "socket.io": "^4.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "mongoose": "^7.5.3",
    "nodemon": "^3.0.1"
  }
}
