# .dockerignore — keep the Docker build context small and stable.
.git
.gitignore
.gitattributes

# CI / IDE / OS junk
.github
.idea
.vscode
.DS_Store
Thumbs.db

# Python caches and build output
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov
.tox
*.egg-info
dist
build
.venv
venv
env

# Node / npm noise
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Local WSL sync scripts and prior backups (rebuilt inside the image)
scripts/
*.backup_pre_sync_*
*backup_pre_sync_*

# Large data files — download inside the image or mount as a volume
data/
*.csv
*.parquet
*.sqlite
*.db

# Docker artefacts referencing themselves
Dockerfile
.dockerignore
docker-compose*.yml
.docker/

# Logs and secrets
*.log
.env
.env.*

# Other repo-root noise that should not enter the image
README.md
*.ps1
